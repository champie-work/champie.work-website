---
<footer data-footer class="ft">
  <div data-parallax-footer class="ft_inner">
    <div class="ft_col">
      <div class="ft_label">Navigation</div>
      <div class="ft_links">
        {links.map((l) => <a href={l.href} class="ft_link">{l.label}</a>)}
      </div>
    </div>
    <div class="ft_col ft_col_right">
      <div class="ft_label">Studio</div>
      <div class="ft_copy">©{new Date().getFullYear()} Champie</div>
      <div class="ft_text ft_based">Based in Enschede, The Netherlands</div>
      <div class="ft_text ft_status"><div data-status-dot class="ft_dot"></div>Open for work</div>
      <a href={`mailto:${email}`} class="ft_text ft_email">{email}</a>
      <div class="ft_label ft_socials_label">Socials</div>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="ft_social">{s.label}<svg viewBox="0 0 15 14" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={arrowUR} /></svg></a>
      ))}
      <a href="#top" class="ft_social ft_top" data-back-to-top>Back to top<svg viewBox="0 0 9 14" class="ft_top_icon" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d={arrowUp} /></svg></a>
      <div aria-hidden="true" data-logo3d-footer class="ft_logo"></div>
    </div>
  </div>
</footer>
