---
// Gele footer, op elke pagina gelijk.
---
<section data-footer class="footer">
  <div data-parallax-footer class="footer_inner">
    <div class="footer_row">
      <div class="footer_contact">
        <div class="hero_status"><div data-status-dot class="hero_status_dot"></div><div>Open for work</div></div>
        <a href="mailto:hello@champie.work" class="link">hello@champie.work</a>
      </div>
      <div class="footer_nav">
        <a data-nav-link href="/#projects" class="hero_nav_link">Projects</a>
        <a data-nav-link href="/#about" class="hero_nav_link">About</a>
        <a data-nav-link href="/#services" class="hero_nav_link">Services</a>
        <a data-nav-link href="/#process" class="hero_nav_link">Process</a>
      </div>
    </div>
    <div aria-hidden="true" data-logo3d-footer class="footer_logo"></div>
    <div class="footer_row">
      <div class="hero_location">
        <div data-clock="enschede" class="hero_mono">--:--:--</div>
        <div data-date="enschede" class="hero_mono">Monday, Oct 19</div>
      </div>
      <div class="footer_socials">
        <a href="https://www.instagram.com/champie.work" target="_blank" class="footer_social"><div class="footer_social_label">Instagram</div><div class="footer_social_handle">@champie.work</div></a>
        <a href="https://www.linkedin.com/in/semvanderwal" target="_blank" class="footer_social"><div class="footer_social_label">LinkedIn</div><div class="footer_social_handle">/semvanderwal</div></a>
      </div>
    </div>
  </div>
</section>
