---
// About (Figma "v2 web" > About page, 567:920). Opmaak: src/styles/v2.css (/* About */).
import Base from '../layouts/Base.astro';
import SubHeader from '../components/SubHeader.astro';
import Eye from '../components/Eye.astro';
import Services from '../components/Services.astro';
import TalkLink from '../components/TalkLink.astro';
import Studio from '../components/Studio.astro';
import Footer from '../components/Footer.astro';
import { socials } from '../data/site.js';
const linkedin = socials.find((s) => s.label === 'LinkedIn').href;
---
<Base title="About | champie.work" menu={false}>
  <main class="page about">
    <SubHeader title="About" />
    <h1 class="page_title about_title">A small studio with<br />big ambitions<Eye class="page_eye" /></h1>
    <div class="grid page_row">
      <div class="label">About</div>
      <p class="body20 with_square">Champie is an independent design studio founded by <a href={linkedin} target="_blank" rel="noopener">Sem van der Wal</a>, working across branding, digital design and web. The focus is on building distinctive identities and digital experiences for people and businesses with something worth putting into the world.</p>
    </div>

    <div class="about_me">
      <img class="about_photo" src="/img/about-sem-van-der-wal.webp" alt="Portret van Sem van der Wal op gele achtergrond" loading="lazy" />
      <div class="about_me_text">
        <div class="about_year">2026</div>
        <h2 class="about_hi">Hi! I am<br />Sem van der Wal</h2>
      </div>
    </div>

    <div class="grid about_services">
      <div></div>
      <div><Services /></div>
    </div>

    <p class="about_21">At 21, I decided to build something of my own rather than take the easiest route</p>
    <h2 class="big_center about_build">I’d rather build it<br />myself.</h2>

    <div class="about_story">
      <div class="body20 with_square"><p>After years of working on design projects, I wanted to take things further. Not just create more work, but build a studio with its own direction, standards and way of working.</p></div>
      <div class="body20 with_square">
        <p>Champie is my way of doing that. A place to challenge myself, work with ambitious people and turn ideas into brands and digital experiences that stand out.</p>
        <p>I'm still at the beginning, and that's exactly how I want it. There's a lot to build, a lot to learn and plenty of room to do things differently.</p>
      </div>
    </div>

    <h2 class="big_center about_wait">I didn't want to wait for the right opportunity.<br />I wanted to create it.</h2>
    <TalkLink />
  </main>
  <Studio />
  <Footer />
</Base>
