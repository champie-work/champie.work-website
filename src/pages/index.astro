---
// Homepage V2 (Figma "v2 web" > Homepage). Opmaak: src/styles/v2.css.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';
import Nav from '../components/Nav.astro';
import { email } from '../data/site.js';

const projects = [
  { title: 'Ralph Lauren', hover: 'A Study in Timeless Style', meta: 'Exploration + Case Study', href: '/project/ralph-lauren',
    img: '/img/home-ralph-lauren.webp', alt: 'Ralph Lauren campagnebeeld: man met bruine hoed en leren jas', ratio: '684 / 750', bg: '#121214' },
  { title: 'Zodiac', hover: 'Color has Character', meta: 'Exploration + Case Study', href: null,
    img: '/img/home-zodiac.webp', alt: 'Zodiac Super Sea Wolf horloge op blauwe achtergrond', ratio: '684 / 860', bg: '#0f7cff' },
];

const services = ['Creative & Art direction', 'Web Design & Development', 'Webflow Development', 'Branding', 'Digital Design'];

// Insights: nog voorbeelden. Later via Keystatic. color = vlak zolang er geen beeld is.
const insights = [
  { title: 'Creation of Champie', author: 'Sem van der Wal', time: '5 min', ratio: '684 / 640', color: '#ffc82e' },
  { title: 'Creation of Champie', author: 'Sem van der Wal', time: '5 min', ratio: '684 / 420', color: '#131416' },
];

// FAQ: de eerste staat open. Antwoorden 2 t/m 5 zijn een CONCEPT (stond niet in Figma) — graag nalezen.
const faq = [
  { q: 'Who do you usually work with?', a: 'I work with founders, growing businesses and established brands looking to build, improve or rethink their visual identity and digital presence. Projects vary in size, but the common ground is an ambition to create something distinctive.' },
  { q: 'Who will be working on my project?', a: 'Me. Champie is a one-person studio, so you work directly with the designer from the first call to the final file. When a project needs extra hands, I bring in people I trust and tell you upfront.' },
  { q: 'What services do you offer?', a: 'Creative and art direction, branding, digital design and web design and development, including Webflow. Most projects combine a few of these.' },
  { q: 'Do I need a complete rebrand or just a website?', a: 'It depends on where you are. If your brand still fits, a new website can be enough. If it no longer reflects who you are, it pays to start with the identity. We figure that out together in the first call.' },
  { q: 'How long do projects usually take?', a: 'A website or identity usually takes between four and ten weeks, depending on the scope. You get a clear planning before we start.' },
];

const arrowUR = 'M0.630664 0H8.625V7.99434H6.84848V3.02896L1.26133 8.625L0 7.36367L5.59604 1.77652H0.630664V0Z';
const chevron = 'M10.59 0L6 4.58L1.41 0L0 1.41L6 7.41L12 1.41L10.59 0Z';
const eyeWhite = 'M50.2317 0.0344637H15.2638L0 0.0108833C1.20804 7.31719 5.95859 13.6694 11.7521 18.0717C28.028 30.4115 54.2132 30.377 70.4166 17.9356C76.1593 13.5061 80.7648 7.29542 82 0L50.2299 0.0344637H50.2317Z';
const eyePupil = 'M49.1448 4.53651C49.1448 13.956 41.5302 21.5942 32.1379 21.5942C22.7457 21.5942 15.1328 13.956 15.1328 4.53651C15.1328 2.96388 15.3468 1.44385 15.7459 0H48.5299C48.929 1.44385 49.1448 2.96206 49.1448 4.53651Z';
---
<Base>
  <header id="top" data-hero class="hero">
    <h1 data-parallax-hero class="hero_wordmark"><Wordmark /></h1>
    <div data-parallax-hero class="hero_row">
      <div class="status"><div data-status-dot aria-hidden="true" class="status_dot"></div>Open for work</div>
      <Nav class="hero_nav" />
    </div>
    <div data-logo3d class="hero_logo3d"></div>
    <div data-parallax-hero class="hero_bottom">
      <div class="mono">
        <div data-clock="enschede">--:--:--</div>
        <div data-date="enschede">Monday, Oct 19</div>
      </div>
      <p class="mono">For brands with something to say.<br />Design that makes them heard.</p>
    </div>
  </header>

  <section class="intro">
    <p class="intro_text">Independent design<svg aria-hidden="true" viewBox="0 0 82 28" data-eye class="intro_eye"><path fill="#FBFAF7" d={eyeWhite} /><path fill="#0E0E10" d={eyePupil} /></svg>studio based in Enschede. Working across branding, digital and web to help ambitious founders and brands stand out.</p>
  </section>

  <section id="projects" class="projects">
    <div class="grid label_row">
      <div class="label_split"><div class="label">Projects</div><div class="label is-muted">{projects.length}</div></div>
      <p class="label label_right">Selected explorations<br />and projects.</p>
    </div>
    <div class="grid projects_grid">
      {projects.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <Tag data-project class="project" href={p.href}>
            <div data-project-media class="project_media" style={`aspect-ratio:${p.ratio};background:${p.bg}`}>
              <img class="cover" src={p.img} alt={p.alt} data-parallax-img loading="lazy" />
            </div>
            <div class="project_caption">
              <div data-project-title data-hover-title={p.hover} class="project_title">{p.title}</div>
              <div class="project_meta">{p.meta}</div>
            </div>
          </Tag>
        );
      })}
    </div>
    <!-- Pijl voor de hovertitel: project-hover.js kopieert hem in elke kaart -->
    <div hidden><svg data-project-arrow class="project_arrow" viewBox="0 0 14 15" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M13.854 10.146a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L12.293 11H2.5A2.5 2.5 0 0 1 0 8.5v-8a.5.5 0 0 1 1 0v8A1.5 1.5 0 0 0 2.5 10h9.793L9.146 6.854a.5.5 0 1 1 .708-.708l4 4Z" /></svg></div>
  </section>

  <section id="services" class="services">
    <h2 class="services_heading">From identity to<br />digital experience.</h2>
    <div class="grid services_row">
      <div class="services_side">
        <svg aria-hidden="true" viewBox="0 0 82 28" data-eye="flip" class="services_eye"><path fill="#FBFAF7" d={eyeWhite} /><path fill="#0E0E10" d={eyePupil} /></svg>
        <div class="label is-muted services_count">{services.length}</div>
      </div>
      <div>
        <div class="label">Services</div>
        <div class="services_list">
          {services.map((s) => (
            <div data-service-row class="service_row">{s}<div data-row-icon class="service_icon"><svg viewBox="0 0 9 9" aria-hidden="true"><path fill="currentColor" d={arrowUR} /></svg></div></div>
          ))}
        </div>
        <a href="/process" class="label link_right">View the process</a>
      </div>
    </div>
  </section>

  <section class="insights">
    <div class="label_split insights_labels"><div class="label label_16">Insights</div><div class="label is-muted">{insights.length}</div></div>
    <div class="grid insights_grid">
      {insights.map((i) => (
        <div data-insight class="insight">
          <div class="insight_media" style={`aspect-ratio:${i.ratio};background:${i.color}`}></div>
          <div class="insight_row">
            <div>
              <div class="insight_title">{i.title}</div>
              <div class="insight_author">Author: {i.author}</div>
            </div>
            <div data-insight-time class="insight_time"><svg viewBox="0 0 7 11" aria-hidden="true"><path fill="currentColor" d="M0 0V3.3L2.33333 5.5L0 7.7V11H7V7.7L4.66667 5.5L7 3.3V0H0Z" /></svg>{i.time}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="faq" class="cta">
    <h2 class="cta_heading">Have something<br />worth building?</h2>
    <p class="mono cta_sub">Let's talk about your idea, what you're aiming for<br />and how good design can help get you there.</p>
    <div class="faq">
      <div class="label">FAQ</div>
      <div>
        {faq.map((f, i) => (
          <details name="faq" class="faq_item" open={i === 0}>
            <summary class="faq_q">{f.q}<svg viewBox="0 0 12 8" aria-hidden="true"><path fill="currentColor" d={chevron} /></svg></summary>
            <p class="faq_a">{f.a}</p>
          </details>
        ))}
        <a href="/start-a-project#faq" class="label link_right">View all FAQ</a>
      </div>
    </div>
    <a href={`mailto:${email}`} class="cta_call">
      <img class="cta_photo" src="/img/sem-van-der-wal.webp" alt="Portret van Sem van der Wal op gele achtergrond" loading="lazy" />
      <div class="cta_book">
        <div><span class="mono16">Schedule a call</span><br /><span class="mono16">with</span> <strong>Sem van der Wal</strong></div>
        <div class="cta_btn"><svg viewBox="0 0 10 10" aria-hidden="true"><path fill="currentColor" d="M0.710938 0H9.71094V9H7.71094V3.41L1.42094 9.71L0.000938416 8.29L6.30094 2H0.710938V0Z" /></svg></div>
      </div>
    </a>
  </section>

  <section class="studio">
    <img class="studio_bg" src="/img/home-studio.webp" alt="" loading="lazy" />
    <p class="mono studio_text">For brands with something to say.<br />Design that makes them heard.<br /><br /><br /><br /><a href={`mailto:${email}`}>{email}</a></p>
  </section>

  <Footer />
</Base>
